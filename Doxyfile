# Doxygen configuration of the Zamin Engine API reference (Doxygen 1.9+).
#
#   doxygen                        # from the repository root -> build/docs/html/index.html
#   cmake --build build --target docs   # the same through CMake (only when Doxygen was found)
#
# Only the settings that differ from Doxygen's defaults are listed (a missing tag keeps its default;
# `doxygen -x Doxyfile` prints this file's difference to the defaults, `doxygen -g full.cfg` a full template).
# The output (build/docs) is under build/, which is not in git. The input is the engine's public headers
# (Zamin/src/Zamin): the API games, the editor and the player use. Their /// comments are the reference;
# the user guides (in Uzbek) are the Markdown files of docs/ - docs/README.md is their index.
# Warnings go to build/docs/doxygen-warnings.log (undocumented members are not warned about: EXTRACT_ALL
# lists them anyway; mistakes in the comments are).

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "Zamin Engine"
# Keep equal to project(Zamin VERSION ...) of CMakeLists.txt (Tests/docs_check.py checks it).
PROJECT_NUMBER         = 0.1.0
PROJECT_BRIEF          = "C++20 2D / 3D game engine: editor, player, C++ scripts"
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = Zamin/src
STRIP_FROM_INC_PATH    = Zamin/src
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
DISTRIBUTE_GROUP_DOC   = NO
TAB_SIZE               = 4
# The engine is one namespace (Zamin): its members are listed by file and class, not by namespace scope.
INLINE_SIMPLE_STRUCTS  = NO
TYPEDEF_HIDES_STRUCT   = NO
LOOKUP_CACHE_SIZE      = 2

#---------------------------------------------------------------------------
# What is extracted
#---------------------------------------------------------------------------
# Every public class and member is listed, documented or not (the reference is complete); private
# members and the implementation files are left out.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
HIDE_IN_BODY_DOCS      = YES
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
INLINE_INFO            = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SORT_BY_SCOPE_NAME     = NO
GENERATE_TODOLIST      = NO
GENERATE_TESTLIST      = NO
GENERATE_BUGLIST       = NO
GENERATE_DEPRECATEDLIST= YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           = build/docs/doxygen-warnings.log

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = Zamin/src/Zamin
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h
RECURSIVE              = YES
# Icons.h: Font Awesome code points only; Miniaudio.h: the vendor library's include wrapper;
# ImGuiConfig.h: Dear ImGui's compile-time configuration; GlfwWindow.h: the platform implementation.
EXCLUDE                = Zamin/src/Zamin/ImGui/Icons.h \
                         Zamin/src/Zamin/ImGui/ImGuiConfig.h \
                         Zamin/src/Zamin/Audio/Miniaudio.h \
                         Zamin/src/Zamin/Platform
EXCLUDE_SYMBOLS        = entt \
                         glm \
                         std \
                         JPH \
                         detail \
                         Detail \
                         Internal
EXAMPLE_PATH           = Projects/Platformer2D/Source \
                         Projects/Showcase3D/Source \
                         Projects/Adventure3D/Source
EXAMPLE_PATTERNS       = *.cpp *.h
EXAMPLE_RECURSIVE      = YES
# The main page: the umbrella header's @mainpage block (Zamin/Zamin.h).
USE_MDFILE_AS_MAINPAGE =

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
VERBATIM_HEADERS       = YES
ALPHABETICAL_INDEX     = YES

#---------------------------------------------------------------------------
# HTML output (the only one)
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = AUTO_LIGHT
HTML_DYNAMIC_SECTIONS  = YES
HTML_INDEX_NUM_ENTRIES = 100
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = NO
ENUM_VALUES_PER_LINE   = 1
TREEVIEW_WIDTH         = 280
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = NO
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
GENERATE_AUTOGEN_DEF   = NO
GENERATE_PERLMOD       = NO

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------
# The headers are read as a Development (non-Shipping) build with asserts and debug drawing, so every
# function is listed once with its real declaration.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = YES
INCLUDE_PATH           = Zamin/src
INCLUDE_FILE_PATTERNS  = *.h
PREDEFINED             = __linux__ \
                         ZM_DEBUG_DRAW=1 \
                         ZM_ENABLE_ASSERTS=1 \
                         GLM_ENABLE_EXPERIMENTAL
SKIP_FUNCTION_MACROS   = YES

#---------------------------------------------------------------------------
# Diagrams (Graphviz dot; the CMake target turns them off when dot is missing)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = NO
GROUP_GRAPHS           = NO
UML_LOOK               = NO
TEMPLATE_RELATIONS     = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = NO
DOT_GRAPH_MAX_NODES    = 40
MAX_DOT_GRAPH_DEPTH    = 2
DOT_MULTI_TARGETS      = YES
DOT_CLEANUP            = YES
