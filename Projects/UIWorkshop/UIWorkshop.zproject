{
  "Version": 2,
  "Project": {
    "Name": "UIWorkshop",
    "StartScene": "Scenes/UI2D.zscene",
    "AssetDirectory": "Assets",
    "SourceDirectory": "Source",
    "ScriptModulePath": "",
    "Description": "Live HUD, paged inventory, modal focus/pause and compiler-free save/load UI.",
    "Thumbnail": "Thumbnail.png"
  },
  "Player": {
    "Product": "Zamin UI Workshop",
    "Width": 1280,
    "Height": 720,
    "VSync": true
  },
  "InputActions": {
    "Actions": [
      {
        "Bindings": [
          "Key:Space",
          "Gamepad:A"
        ],
        "Name": "Jump"
      },
      {
        "Bindings": [
          "Mouse:Left",
          "Key:LeftControl",
          "GamepadAxis:RightTrigger+"
        ],
        "Name": "Fire"
      },
      {
        "Bindings": [
          "Key:E",
          "Gamepad:X"
        ],
        "Name": "Interact"
      },
      {
        "Bindings": [
          "Key:LeftShift",
          "Gamepad:LeftThumb"
        ],
        "Name": "Sprint"
      },
      {
        "Bindings": [
          "Key:Escape",
          "Gamepad:Start"
        ],
        "Name": "Pause"
      },
      {
        "Name": "Inventory",
        "Bindings": [
          "Key:I",
          "Gamepad:Y"
        ]
      }
    ],
    "Axes": [
      {
        "Deadzone": 0.15,
        "GamepadAxis": "LeftX",
        "Invert": false,
        "Name": "Horizontal",
        "Negative": [
          "Key:A",
          "Key:Left",
          "Gamepad:DPadLeft"
        ],
        "Positive": [
          "Key:D",
          "Key:Right",
          "Gamepad:DPadRight"
        ]
      },
      {
        "Deadzone": 0.15,
        "GamepadAxis": "LeftY",
        "Invert": true,
        "Name": "Vertical",
        "Negative": [
          "Key:S",
          "Key:Down",
          "Gamepad:DPadDown"
        ],
        "Positive": [
          "Key:W",
          "Key:Up",
          "Gamepad:DPadUp"
        ]
      }
    ],
    "Vectors": [
      {
        "Deadzone": 0.0,
        "Mode": "Clamp",
        "Name": "Move",
        "X": "Horizontal",
        "Y": "Vertical"
      }
    ]
  }
}
