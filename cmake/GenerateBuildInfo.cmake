# Writes the engine's build information (Zamin/Core/BuildInfo.cpp includes it): the git commit the
# engine was built from, whether the tree had changes, the commit's date and the build's date.
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<file.inc> -DBUILD_TYPE=<Debug|Release...> -P GenerateBuildInfo.cmake
# Runs on every build; the file is only rewritten when something in it changed (the date is a day, so
# the engine is not rebuilt each time). SOURCE_DATE_EPOCH (reproducible builds) sets the build date.
# Without git (a source archive) the commit is empty.
set(ZM_COMMIT "")
set(ZM_COMMIT_DATE "")
set(ZM_DIRTY 0)
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git")
    execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short=10 HEAD
        WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE ZM_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _result ERROR_QUIET)
    if(NOT _result EQUAL 0)
        set(ZM_COMMIT "")
    endif()
    if(ZM_COMMIT)
        execute_process(COMMAND ${GIT_EXECUTABLE} log -1 --format=%cs
            WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE ZM_COMMIT_DATE OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        # Changes to tracked files (untracked ones - build folders, notes - do not count).
        execute_process(COMMAND ${GIT_EXECUTABLE} status --porcelain --untracked-files=no
            WORKING_DIRECTORY ${SOURCE_DIR} OUTPUT_VARIABLE _status OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT _status STREQUAL "")
            set(ZM_DIRTY 1)
        endif()
    endif()
endif()
string(TIMESTAMP ZM_BUILD_DATE "%Y-%m-%d" UTC)
if(NOT BUILD_TYPE)
    set(BUILD_TYPE "Release")
endif()

set(_content "// Generated by cmake/GenerateBuildInfo.cmake - do not edit.
#define ZM_BUILD_COMMIT \"${ZM_COMMIT}\"
#define ZM_BUILD_COMMIT_DATE \"${ZM_COMMIT_DATE}\"
#define ZM_BUILD_DIRTY ${ZM_DIRTY}
#define ZM_BUILD_DATE \"${ZM_BUILD_DATE}\"
#define ZM_BUILD_TYPE \"${BUILD_TYPE}\"
")
set(_old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _old)
endif()
if(NOT _old STREQUAL _content)
    file(WRITE "${OUTPUT}" "${_content}")
endif()
