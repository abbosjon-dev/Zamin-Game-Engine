# Writes the names declared directly in namespace Zamin (types, aliases, nested namespaces)
# to OUTPUT as a C++ string list. A script class with one of these names clashes with
# `using namespace Zamin;`, so ScriptTemplate::ValidateClassName rejects them.
#   cmake -DSOURCE_DIR=<Zamin/src/Zamin> -DOUTPUT=<file.inc> -P GenerateEngineNames.cmake
file(GLOB_RECURSE headers ${SOURCE_DIR}/*.h)
list(SORT headers)
set(names "")
foreach(header IN LISTS headers)
    file(STRINGS ${header} lines REGEX "^(    (class|struct|enum|using|namespace) |namespace Zamin::)")
    foreach(line IN LISTS lines)
        if(line MATCHES "^    (class|struct|enum class|enum struct|enum|using|namespace) ([A-Za-z_][A-Za-z0-9_]*)")
            set(name ${CMAKE_MATCH_2})
        elseif(line MATCHES "^namespace Zamin::([A-Za-z_][A-Za-z0-9_]*)")
            set(name ${CMAKE_MATCH_1})
        else()
            continue()
        endif()
        if(NOT name STREQUAL "namespace" AND NOT name STREQUAL "class" AND NOT name STREQUAL "struct")
            list(APPEND names ${name})
        endif()
    endforeach()
endforeach()
list(REMOVE_DUPLICATES names)
list(SORT names)

set(content "// Generated by cmake/GenerateEngineNames.cmake: names declared in namespace Zamin.\n")
foreach(name IN LISTS names)
    string(APPEND content "\"${name}\",\n")
endforeach()

# Only touch the file when the list changed (no needless recompiles).
set(old "")
if(EXISTS ${OUTPUT})
    file(READ ${OUTPUT} old)
endif()
if(NOT old STREQUAL content)
    file(WRITE ${OUTPUT} "${content}")
endif()
