# The manifest uses paths relative to labelled roots, so moving a checkout does not change its hash.
function(zamin_compute_sdk_fingerprint output)
    set(manifest "zamin-sdk-abi-v1\n${ZAMIN_SDK_ABI_TOOLCHAIN}\n${ZAMIN_SDK_ABI_DEFINITIONS}\n")
    set(dependencies "")
    foreach(root IN LISTS ZAMIN_SDK_ABI_ROOTS)
        if(NOT IS_DIRECTORY "${root}")
            message(FATAL_ERROR "Zamin SDK ABI root is missing: ${root}")
        endif()
        file(GLOB_RECURSE headers CONFIGURE_DEPENDS RELATIVE "${root}" "${root}/*.h" "${root}/*.hpp" "${root}/*.inl")
        list(SORT headers)
        get_filename_component(label "${root}" NAME)
        foreach(header IN LISTS headers)
            file(SHA256 "${root}/${header}" hash)
            string(APPEND manifest "${label}/${header}:${hash}\n")
            list(APPEND dependencies "${root}/${header}")
        endforeach()
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${dependencies})
    string(SHA256 fingerprint "${manifest}")
    set(${output} "${fingerprint}" PARENT_SCOPE)
endfunction()

function(zamin_attach_module_abi target)
    if(NOT ZAMIN_SDK_ABI_FINGERPRINT)
        message(FATAL_ERROR "Zamin SDK has no ABI fingerprint. Rebuild the engine and reconfigure the game.")
    endif()
    set(current_toolchain "${CMAKE_CXX_COMPILER_ID}|${CMAKE_CXX_COMPILER_VERSION}|${CMAKE_SYSTEM_PROCESSOR}|${CMAKE_SIZEOF_VOID_P}|cxx20")
    if(NOT current_toolchain STREQUAL ZAMIN_SDK_ABI_TOOLCHAIN)
        message(FATAL_ERROR "Zamin SDK toolchain mismatch. Use ${ZAMIN_SDK_ABI_TOOLCHAIN}, got ${current_toolchain}.")
    endif()
    get_property(checked GLOBAL PROPERTY ZAMIN_SDK_ABI_CHECKED)
    if(NOT checked)
        zamin_compute_sdk_fingerprint(current_fingerprint)
        if(NOT current_fingerprint STREQUAL ZAMIN_SDK_ABI_FINGERPRINT)
            message(FATAL_ERROR "Zamin SDK headers changed since the engine build. Rebuild the engine, then reconfigure the game.")
        endif()
        set_property(GLOBAL PROPERTY ZAMIN_SDK_ABI_CHECKED TRUE)
    endif()
    set(source "${CMAKE_CURRENT_BINARY_DIR}/${target}-ZaminModuleABI.cpp")
    file(CONFIGURE OUTPUT "${source}" CONTENT
"#include <Zamin/Scripting/ModuleABIRecord.h>
#if defined(__linux__)
extern \"C\" __attribute__((section(\".zamin_abi\"), used, visibility(\"default\")))
const Zamin::Detail::ModuleABIRecord ZaminModuleABI = Zamin::Detail::MakeModuleABIRecord(\"${ZAMIN_SDK_ABI_FINGERPRINT}\");
#endif
" @ONLY)
    target_sources(${target} PRIVATE "${source}")
endfunction()
